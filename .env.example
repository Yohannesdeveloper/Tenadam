# Railway PostgreSQL connection string
# Railway > your Postgres service > Connect tab > DATABASE_URL
DATABASE_URL=postgresql://postgres:your-password@your-host.railway.app:5432/railway

# NextAuth configuration (generate a secret with: openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Groq API key for the AI chatbot (free tier, starts with gsk_)
GROQ_API_KEY=gsk_your-groq-key
